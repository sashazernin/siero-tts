{
  "name": "@siero-tts/source",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"nx serve api\" \"wait-on -t 120000 http-get://127.0.0.1:8000/api/health && nx serve web\"",
    "dev:e": "concurrently -k -n web,electron \"nx serve web --host=127.0.0.1 --port=4200\" \"wait-on -t 120000 tcp:127.0.0.1:4200 && electron apps/desktop/src/main.js\"",
    "prod": "concurrently -k -n api,web \"node dist/apps/api/main.js\" \"wait-on -t 120000 http-get://127.0.0.1:8000/api/health && vite preview --config apps/web/vite.config.ts --port 4200 --host 127.0.0.1\"",
    "prod:e": "electron apps/desktop/src/main.js --prod",
    "build": "nx run-many -t build -p web,api --parallel=2",
    "build:e": "nx build desktop",
    "build:e:zip": "node apps/desktop/scripts/prepare-pack.js && electron-builder --config electron-builder.json --win zip"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@nx/esbuild": "^21.2.0",
    "@nx/jest": "^21.2.0",
    "@nx/js": "^21.2.0",
    "@nx/react": "^21.2.0",
    "@nx/vite": "^21.2.0",
    "@nx/workspace": "^21.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.30",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@fastify/cors": "^10.0.2",
    "concurrently": "^9.2.1",
    "identity-obj-proxy": "^3.0.0",
    "fastify": "^5.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nx": "^21.2.0",
    "ts-jest": "^29.3.2",
    "tslib": "^2.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.5",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  }
}
